{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["svelte", "node"],
		"baseUrl": ".",
		"paths": {
			"$lib/*": ["../../src/lib/*"]
		}
	},
	"include": [
		"../../src/lib/disc-studio/**/*",
		"../../src/routes/disc-studio/**/*",
		"./main.ts",
		"./vite.config.ts"
	]
}
