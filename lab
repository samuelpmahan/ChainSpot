#!/usr/bin/env bash
# ChainSpot LAB toolkit entrypoint (POSIX).
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lab_dir="$repo_dir/scripts/chainspot-lab"
tsx="$lab_dir/node_modules/.bin/tsx"

if ! command -v node >/dev/null 2>&1; then
	export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
	# shellcheck disable=SC1091
	[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
fi

usage() {
	cat >&2 <<'HELP'
LAB — tools for seeing, measuring, testing, and learning ChainSpot CV

Usage: ./lab <command> [args]

LOOK
  scope        inspect image regions, trace geometry/search, batch, contact-sheet

KNOW
  invariants   observed renderer truths
  detectors    detector registry
  gates        pipeline/gate vocabulary
  cases        hard-evidence cases

RUN
  compile      inspect/compile an algorithm config (no raster execution)
  sweep        execute a config against raster input through the LAB gateway

PROVENANCE
  orient 3fd72 [--verbose]   machine-bound frozen-reference auditor

Discover from here:
  ./lab scope --help
  ./lab compile --help
  ./lab sweep --help

LAB rule: successful commands should leave a useful artifact/handle and point
toward the nearest next operation. Prefer --help over source inspection.
HELP
}

cmd="${1:-}"
if [ "$cmd" = "" ] || [ "$cmd" = "--help" ] || [ "$cmd" = "-h" ] || [ "$cmd" = "help" ]; then
	usage
	exit 0
fi
shift

if [ "$cmd" = "orient" ]; then
	if [ "${1:-}" != "3fd72" ]; then
		usage
		exit 2
	fi
	shift
	exec node "$repo_dir/scripts/lab-orient-3fd72.mjs" "$@"
fi

if [ ! -x "$tsx" ]; then
	echo "LAB dependencies are not installed. Run: (cd scripts/chainspot-lab && npm install)" >&2
	exit 1
fi

case "$cmd" in
	invariants | detectors | gates | cases)
		exec "$tsx" "$lab_dir/$cmd.ts" "$@"
		;;
	compile | sweep)
		exec "$tsx" "$lab_dir/sweep/sweepCli.ts" "$cmd" "$@"
		;;
	scope)
		exec "$tsx" "$lab_dir/scope/scopeCli.ts" "$@"
		;;
	*)
		usage
		exit 2
		;;
esac
