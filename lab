#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_dir"

case "${1:-}" in
	grid)
		shift
		exec "$repo_dir/node_modules/.bin/tsx" "$repo_dir/scripts/lab-grid.ts" "$@"
		;;
	check)
		shift
		exec "$repo_dir/node_modules/.bin/tsx" "$repo_dir/scripts/lab-check.ts" "$@"
		;;
	*)
		echo "Usage: ./lab grid <course> | ./lab check <badges|baskets|tees> <course>" >&2
		exit 2
		;;
esac
