{
	"name": "@chainspot/alg",
	"version": "0.0.1",
	"private": true,
	"description": "Pure course-detection algorithm: detectors, auto-crop, stitch. No DOM, no SvelteKit.",
	"type": "commonjs",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./detectors/labEndpoint": {
			"types": "./dist/detectors/labEndpoint/index.d.ts",
			"default": "./dist/detectors/labEndpoint/index.js"
		},
		"./detectors/threeFactor": {
			"types": "./dist/detectors/threeFactor/index.d.ts",
			"default": "./dist/detectors/threeFactor/index.js"
		},
		"./exec": {
			"types": "./dist/exec/index.d.ts",
			"default": "./dist/exec/index.js"
		},
		"./exec/node-sink": {
			"types": "./dist/exec/node-sink.d.ts",
			"default": "./dist/exec/node-sink.js"
		},
		"./exec/node-intake": {
			"types": "./dist/exec/node-intake.d.ts",
			"default": "./dist/exec/node-intake.js"
		},
		"./*.json": "./dist/*.json",
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs"
	}
}
